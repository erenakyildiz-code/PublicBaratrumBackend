<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <UserSecretsId>d694291a-80bd-4e3c-9644-2993da9cc84d</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup>
    <BrainEndpoint Condition="'$(BrainEndpoint)' == ''">http://127.0.0.1:8080</BrainEndpoint>
    <EarsEndpoint  Condition="'$(EarsEndpoint)' == ''">http://127.0.0.1:8000</EarsEndpoint>
    <MouthEndpoint Condition="'$(MouthEndpoint)' == ''">https://devil-macbook-air-2.tail1737c0.ts.net</MouthEndpoint>
    <RunningLocal Condition="'$(RunningLocal)' == ''">true</RunningLocal>
    <BrainHeaders Condition="'$(BrainHeaders)' == ''"></BrainHeaders>
    <EarsHeaders  Condition="'$(EarsHeaders)' == ''"></EarsHeaders>
    <MouthHeaders Condition="'$(MouthHeaders)' == ''"></MouthHeaders>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BrainEndpoint" Value="$(BrainEndpoint)" />
    <AssemblyMetadata Include="EarsEndpoint"  Value="$(EarsEndpoint)" />
    <AssemblyMetadata Include="MouthEndpoint" Value="$(MouthEndpoint)" />
    <AssemblyMetadata Include="RunningLocal" Value="$(RunningLocal)" />
    <AssemblyMetadata Include="BrainHeaders" Value="$(BrainHeaders)" />
    <AssemblyMetadata Include="EarsHeaders"  Value="$(EarsHeaders)" />
    <AssemblyMetadata Include="MouthHeaders" Value="$(MouthHeaders)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    <PackageReference Include="VadSharp" Version="1.0.1" />
  </ItemGroup>
    <ItemGroup>
    <None Update="Templates\RegisterEmail.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
